# Copy to .env and fill in. .env is git-ignored.

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# Postgres. In prod the app reaches the db container by name (fakeservers-db).
POSTGRES_USER=fakeservers
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fakeservers
# dev: host port of the Postgres container (see ../PORTS.md, project 02)
POSTGRES_PORT=4402
DATABASE_URL=postgres://fakeservers:change-me@localhost:4402/fakeservers

# HTTP port the server listens on. dev API 4202, prod container 4102 (PROD_PORT maps it outside).
PORT=4202
PROD_PORT=4102

# Collector: how often to pull GetServerList (minutes) and whether to run on start.
COLLECT_INTERVAL_MIN=60
COLLECT_ON_START=1

# Reports: max reports per client per hour.
REPORT_RATE_PER_HOUR=5
# Set to 1 when behind Cloudflare/Caddy so the client IP is taken from headers.
TRUST_PROXY=0

# Daily export of aggregates into data/YYYY/MM/DD.json after each collection (completed days only).
# Prod compose turns it on. With DATA_PUSH_TOKEN set, each file is also committed to the repository
# through the GitHub API: a fine-grained personal access token for this repo only, permission
# "Contents: Read and write" (https://github.com/settings/personal-access-tokens).
DATA_EXPORT=0
DATA_DIR=
DATA_REPO=romashuhov/fakeservers.link
DATA_BRANCH=main
DATA_PUSH_TOKEN=

# Token for GET /api/views (page counters). Empty means the endpoint returns 404.
ADMIN_TOKEN=

# Public origin of the site, for absolute link-preview URLs (og:image, og:url).
PUBLIC_URL=https://fakeservers.link
